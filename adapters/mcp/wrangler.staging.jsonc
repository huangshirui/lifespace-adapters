{
  // STAGING ONLY. Independent private transport Worker behind Core.
  // Must be deployed before Core adds its MCP_ADAPTER service binding.
  // No custom route, workers.dev URL, or preview URL is allowed here.
  "name": "lifespace-mcp-adapter-staging",
  "main": "src/identity-oauth-worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "staging",
    "MCP_RESOURCE_ORIGIN": "https://core-staging.aisr.online",
    "MCP_OAUTH_ISSUER": "https://auth-staging.aisr.online"
  },
  "services": [
    { "binding": "CORE", "service": "lifespace-core-staging" },
    { "binding": "IDENTITY", "service": "lifespace-identity-staging" }
  ],
  "observability": { "enabled": true }
}
